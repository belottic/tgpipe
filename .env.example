# Get api_id / api_hash from https://my.telegram.org -> API development tools
TGPIPE_API_ID=123456
TGPIPE_API_HASH=0123456789abcdef0123456789abcdef

# Optional
# TGPIPE_SESSION_PATH=tgpipe.session   # relative paths resolve to the project root
# TGPIPE_FORMAT=json                     # json | jsonl | table
# TGPIPE_DOWNLOAD_DIR=downloads          # relative to the current directory
# TGPIPE_FLOOD_MAX_WAIT=60               # seconds of FloodWait absorbed silently
# TGPIPE_SESSION_STRING=                 # StringSession, instead of a session file

# Used only by the non-interactive login
# TGPIPE_PHONE=+39...
# TGPIPE_CODE=12345
# TGPIPE_PASSWORD=...
